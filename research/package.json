{
  "name": "oazy-research",
  "productName": "Oazy Research",
  "version": "2.0.0",
  "description": "Oazy Research: the Core and Council paper indexes, read from GitHub",
  "author": "Oazy",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.oazy.research",
    "productName": "Oazy Research",
    "artifactName": "OazyResearch.exe",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "useZip": false,
      "artifactName": "OazyResearch.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "OazyResearchSetup.exe",
      "shortcutName": "Oazy Research",
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "extraFiles": [
      {
        "from": "art",
        "to": ".",
        "filter": [
          "*.png"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "puppeteer-core": "^25.16.0"
  }
}
