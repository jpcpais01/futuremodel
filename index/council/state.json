"formats":{"floor":{"label":"Open floor","calls":1,"blurb":"Everyone sees everyone. Challenge the weakest arguments, concede what is right, revise."},"cross":{"label":"Cross-examination","calls":2,"blurb":"Each seat puts hard questions to another seat, then answers the questions put to it."},"devil":{"label":"Devil's advocate","calls":1,"blurb":"Each seat attacks its own two largest picks as hard as it can, then keeps or cuts them."},"duel":{"label":"Duels","calls":1,"blurb":"Seats are paired with the seat they disagree with most and rebut each other directly."},"premortem":{"label":"Pre-mortem","calls":1,"blurb":"Six months on, the portfolio has lost 20%. Each seat explains why, then fixes it."},"steelman":{"label":"Steelman","calls":1,"blurb":"Each seat makes the strongest case for the view furthest from its own, then takes what is right."},"closing":{"label":"Closing arguments","calls":1,"blurb":"Final proposals, with the one reason each seat would give the chair."}},
