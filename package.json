{
  "name": "oazy-research",
  "productName": "Oazy Research",
  "version": "3.2.4",
  "description": "Oazy Research: a council of Claude agents and its paper portfolio",
  "author": "Oazy",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "test": "node test/run.js",
    "update": "node engine/cli.js update",
    "estimate": "node engine/cli.js estimate",
    "bundle": "node tools/bundle.js",
    "start": "node tools/bundle.js && electron .",
    "exe": "node tools/bundle.js && electron-builder --win nsis portable",
    "apk": "node tools/bundle.js && bash android/build.sh"
  },
  "build": {
    "appId": "com.oazy.research",
    "productName": "Oazy Research",
    "artifactName": "OazyResearch.exe",
    "files": ["desktop/main.js", "desktop/preload.js", "app/**/*", "package.json", "!node_modules/**/*"],
    "directories": { "output": "dist", "buildResources": "desktop/build" },
    "win": { "target": ["nsis", "portable"], "icon": "desktop/build/icon.ico" },
    "portable": { "useZip": false, "artifactName": "OazyResearch.exe" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "OazyResearchSetup.exe",
      "shortcutName": "Oazy Research",
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "extraFiles": [{ "from": "desktop/art", "to": ".", "filter": ["*.png"] }]
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  }
}
